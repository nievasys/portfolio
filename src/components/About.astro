---
import ASCIIAnimation from "./ascii-animation.tsx";
import { useTranslations } from "../i18n/ui";

const t = useTranslations(Astro.currentLocale);
---

<main
  class="relative flex min-h-[calc(100svh_-_12rem)] flex-col items-center justify-center"
>
  <div class="flex w-full items-center justify-center overflow-hidden pointer-events-none">
    <pre>
 <ASCIIAnimation fps={30} colorOverlay={true} client:visible size="clamp(3.5px,1.4vw,10px)" />
    </pre>
  </div>

  <div class="flex flex-col text-center">
    <pre
      class="leading-none text-[clamp(6px,2vw,0.875rem)]">
           ░██                                                                      
                                                                                    
░████████  ░██ ░███████  ░██    ░██  ░██████        ░███████  ░██    ░██  ░███████  
░██    ░██ ░██░██    ░██ ░██    ░██       ░██      ░██        ░██    ░██ ░██        
░██    ░██ ░██░█████████  ░██  ░██   ░███████       ░███████  ░██    ░██  ░███████  
░██    ░██ ░██░██          ░██░██   ░██   ░██             ░██ ░██   ░███        ░██ 
░██    ░██ ░██ ░███████     ░███     ░█████░██ ░██  ░███████   ░█████░██  ░███████  
                                                                     ░██            
                                                               ░███████             
    </pre>
  </div>

  <section
    class="mt-10 flex w-full max-w-5xl items-start justify-center gap-4 px-4 font-mono sm:gap-6 sm:px-6"
  >
    <pre
      aria-hidden="true"
      class="hidden select-none leading-none text-primary sm:block"
    >
░██
░██
░██
░██
░██
░██
░██
░██
    </pre>

    <h1 class="flex flex-col gap-2 text-left leading-none">
      <span class="text-2xl font-bold text-primary sm:text-3xl">
        nieva agustin
      </span>
      <span class="text-primary/70">{t.about.role}</span>
      <span class="text-primary/70">
        {t.about.currently}
        <span aria-hidden="true" class="text-primary/40">|</span>
        <a
          href="https://github.com/nievasys/matrifermoldes-web"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent transition-colors hover:underline"
        >
          matrifermoldes-web
        </a>
      </span>
      <span class="text-primary/70">
        {t.about.city}
        <span aria-hidden="true" class="text-primary/40">|</span>
        {t.about.country}
      </span>
    </h1>
  </section>
</main>
